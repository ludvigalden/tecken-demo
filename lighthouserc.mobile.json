{
    "ci": {
        "collect": {
            "url": [
                "https://127.0.0.1:8443/",
                "https://127.0.0.1:8443/fingerstavning",
                "https://127.0.0.1:8443/kallor"
            ],
            "numberOfRuns": 3,
            "settings": {
                "chromeFlags": "--headless=new --no-sandbox --ignore-certificate-errors"
            }
        },
        "assert": {
            "assertMatrix": [
                {
                    "matchingUrlPattern": "https://127\\.0\\.0\\.1:8443/(fingerstavning)?$",
                    "assertions": {
                        "categories:performance": [
                            "error",
                            {
                                "minScore": 0.9
                            }
                        ],
                        "categories:accessibility": [
                            "error",
                            {
                                "minScore": 1
                            }
                        ],
                        "largest-contentful-paint": [
                            "warn",
                            {
                                "maxNumericValue": 2500
                            }
                        ],
                        "cumulative-layout-shift": [
                            "error",
                            {
                                "maxNumericValue": 0.1
                            }
                        ],
                        "total-blocking-time": [
                            "error",
                            {
                                "maxNumericValue": 200
                            }
                        ]
                    },
                    "aggregationMethod": "median-run"
                },
                {
                    "matchingUrlPattern": "https://127\\.0\\.0\\.1:8443/kallor$",
                    "assertions": {
                        "categories:performance": [
                            "warn",
                            {
                                "minScore": 0.9
                            }
                        ],
                        "categories:accessibility": [
                            "error",
                            {
                                "minScore": 1
                            }
                        ],
                        "largest-contentful-paint": [
                            "warn",
                            {
                                "maxNumericValue": 2500
                            }
                        ],
                        "cumulative-layout-shift": [
                            "error",
                            {
                                "maxNumericValue": 0.1
                            }
                        ],
                        "total-blocking-time": [
                            "error",
                            {
                                "maxNumericValue": 200
                            }
                        ]
                    },
                    "aggregationMethod": "median-run"
                }
            ]
        },
        "upload": {
            "target": "filesystem",
            "outputDir": ".lighthouseci/mobile"
        }
    }
}
