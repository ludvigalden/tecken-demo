[
    {
        "name": "app initial JS (entry + vue-i18n chunk)",
        "path": [
            "apps/web/dist/assets/index-[A-Za-z0-9_-]*.js",
            "apps/web/dist/assets/vue-i18n.runtime-[A-Za-z0-9_-]*.js"
        ],
        "gzip": true,
        "limit": "137475 B"
    },
    {
        "name": "app CSS",
        "path": "apps/web/dist/assets/index-[A-Za-z0-9_-]*.css",
        "gzip": true,
        "limit": "11537 B"
    },
    {
        "name": "design-system CSS",
        "path": "packages/design-system/dist/*.css",
        "gzip": true,
        "limit": "3207 B"
    },
    {
        "name": "design-system components",
        "path": "packages/design-system/dist/components/*",
        "gzip": true,
        "limit": "8324 B"
    }
]
