{
  "name": "@ludvigalden-demo/tecken-storybook",
  "version": "0.0.0",
  "private": true,
  "description": "Storybook for the Tecken design system.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "storybook build --output-dir storybook-static --disable-telemetry --quiet && node scripts/csp-hashes.mjs storybook-static",
