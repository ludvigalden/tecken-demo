    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@fkui/design": "6.63.0",
    "@fkui/theme-default": "6.63.0",
    "@fkui/vue": "6.63.0",
    "@ludvigalden-demo/tecken-contracts": "0.0.0",
    "@ludvigalden-demo/tecken-design-system": "0.0.0",
    "@storybook/vue3-vite": "10.6.5",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "sass": "1.106.1",
    "storybook": "10.6.5",
    "vite": "8.3.5",
    "vue": "3.5.44"
  }
}
