{
  "name": "@ludvigalden-demo/tecken-design-system",
  "version": "0.0.0",
  "description": "Design tokens and Vue components for the Tecken demonstration, layered on FKUI.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ludvigalden/tecken-demo.git",
    "directory": "packages/design-system"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./fkui-theme.css": "./dist/fkui-theme.css",
    "./components.css": "./dist/components.css",
    "./components/*": "./dist/components/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "generate": "node scripts/generate.mjs",
    "lint": "eslint .",
    "test": "vitest run --coverage --environment jsdom",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fkui/design": "6.63.0",
    "@fkui/icon-lib-default": "6.63.0",
    "@fkui/theme-default": "6.63.0",
    "@fkui/vue": "6.63.0",
    "@ludvigalden-demo/tecken-contracts": "0.0.0",
    "culori": "4.0.2",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/culori": "4.0.1",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "sass": "1.106.1",
    "vitest": "5.0.5"
  },
  "publishConfig": {
